# Copie para .env (desenvolvimento) e ajuste. Nunca versione o .env.
# Em produção, cadastre as mesmas variáveis no Netlify → Project configuration → Environment variables.

# --- Banco ---
# Produção: connection string do Neon com pooling (neon.tech, região São Paulo).
# (Também aceita NETLIFY_DATABASE_URL, criada pela extensão Neon do Netlify.)
# Vazia em desenvolvimento = banco local PGlite em .dados/pglite (não precisa de Docker).
DATABASE_URL=

# --- Imagens enviadas pelo painel ---
# Produção: Netlify Blobs (automático, nada a configurar).
# Desenvolvimento: pasta local (padrão .dados/imagens).
# ARMAZENAMENTO_DIR=

# --- Site ---
# Domínio definitivo (SEO, sitemap). Vazio no Netlify = usa o endereço principal do site.
SITE_URL=http://localhost:3000

# --- Painel gestor (usuário criado no primeiro acesso ao banco vazio) ---
ADMIN_EMAIL=admin@davifotovideo.com.br
ADMIN_SENHA=troque-esta-senha
ADMIN_NOME=Davi

# Chave (Base64, 32 bytes) que cifra os segredos da verificação em duas etapas.
# Gere com: openssl rand -base64 32   — obrigatória em produção.
# Não troque depois de ativar o 2FA (sem ela, só os códigos de recuperação funcionam).
APP_CHAVE_CRIPTO=

# Copie para .env e ajuste. Nunca versione o .env.

# --- Banco ---
DB_NAME=fotografia
DB_USER=fotografia
DB_PASSWORD=troque-esta-senha
# Porta exposta só em 127.0.0.1 (desenvolvimento)
DB_PORTA_LOCAL=5434

# --- Site ---
# Em produção use https://seudominio: os cookies de sessão passam a ser sempre "Secure"
SITE_URL=http://localhost:3000
FRONTEND_PORTA=3000

# --- Galerias ---
GALERIA_DIAS_RETENCAO=60
UPLOAD_MAX_ARQUIVO=30MB
UPLOAD_MAX_REQUISICAO=300MB

# --- Painel gestor (usuário criado na primeira subida) ---
ADMIN_EMAIL=admin@davifotovideo.com.br
# Vazio = senha gerada e exibida uma vez no log do backend
ADMIN_SENHA=
ADMIN_NOME=Davi

# Chave (Base64, 32 bytes) que cifra os segredos da verificação em duas etapas.
# Gere com: openssl rand -base64 32   (vazia = gerada no volume de fotos em .seguranca/chave)
# Guarde-a com o backup do banco: sem ela, quem tem 2FA ativo precisa usar um código de recuperação.
APP_CHAVE_CRIPTO=

# Texto da marca d'água nas prévias da área do cliente
MARCA_DAGUA=DAVIFOTOVIDEO

# --- E-mail (SMTP genérico: Gmail, Brevo, Resend...) ---
# Vazio = e-mails só aparecem no log do backend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_REMETENTE=contato@seudominio.com.br
